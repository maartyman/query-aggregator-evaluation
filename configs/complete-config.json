  "experiments": {
    "wp-overview-experiment": {
      "type": "watchparty-overview-page",
      "iterations": [
        {
          "iterationName": "number-of-joined-watchparties",
          "args": [
            [1],
            [10],
            [20],
            [30],
            [40],
            [50],
            [60]
          ]
        }
      ]
    },
    "wp-messages-experiment": {
